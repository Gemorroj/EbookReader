{
    "name": "gemorroj/ebook-reader",
    "description": "E-books reader",
    "keywords": ["ebook", "reader", "mobi", "azw3", "kf8", "kindle", "epub", "fb2", "html", "htmlz", "txt", "txtz", "prc"],
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gemorroj"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-zip": "*",
        "ext-dom": "*",
        "ext-xmlreader": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "EbookReader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EbookReader\\Tests\\": "tests/"
        }
    }
}
